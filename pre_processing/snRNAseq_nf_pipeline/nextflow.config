// All process settings below are for a slurm executor in a HPC environment. 
// In some cases, singularity containers, downloadable from Galaxy Hub (), were used.
// Alternatively, when and where slurm modules were used, the software and their versions are specified.
// The exact version and container name are included below for reproducibility.
// Change the settings and options based on the native execution environment.

process {
  executor = 'slurm'
  // Add the account information if relevant, below
  clusterOptions = {'-A '}
  // Add the correct scratch or temp folder below. This is optional, but recommended.
  scratch = '$SNIC_TMP'
  errorStrategy = 'ignore'

  withName: COUNT {
    //module = 'CellRanger/9.0.0'
    clusterOptions = {'-t 20:00:00 -J count -N 1 -n 20 -o count_%j.out -e count_%j.err'}
  }

  withName: ORGANIZE_COUNT_OUTPUT {
    clusterOptions = {'-t 10:00:00 -J organize_count -N 1 -n 4 -o organize_count_%j.out -e organize_count_%j.err'}
  }
  
  withName: MULTIQC {
    //container = '/path/multiqc-1.28--pyhdfd78af_0.sif'
    clusterOptions = {'-t 10:00:00 -J multiqc -N 1 -n 8 -o multiqc_%j.out -e multiqc_%j.err'}
  }

  withName: EXTRACT_BARCODE {
    //module = ['GCCcore/14.3.0', 'zlib/1.3.1']
    clusterOptions = {'-t 48:00:00 -J lin_bc -N 1 -n 20 -o lin_bc_%j.out -e lin_bc_%j.err'}
  }
}

executor {
    name = 'slurm'
    queueSize = params.queue_size //Queue size is defined in the params.json file
}

singularity {
    enabled = true
    autoMounts = true
}
