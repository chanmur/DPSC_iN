// All process settings below are for a slurm executor in a HPC environment. 
// In all cases, singularity containers, downloadable from Galaxy Hub (), were used.
// The exact version and container name are included below for reproducibility.
// Change the settings and options based on the native execution environment.

process {
  executor = 'slurm'
  // Add the account information if relevant, below
  clusterOptions = {'-A '}
  // Add the correct scratch or temp folder below. This is optional, but recommended.
  scratch = '$SNIC_TMP'
  errorStrategy = 'ignore'

  withName: FASTQC {
    //container = '/path/fastqc-0.12.1--hdfd78af_0.sif'
    clusterOptions = {'-t 10:00:00 -J fastqc -N 1 -n 10 -o fastqc_%j.out -e fastqc_%j.err'}
  }

  withName: MULTIQC {
    //container = '/path/multiqc-1.28--pyhdfd78af_0.sif'
    clusterOptions = {'-t 10:00:00 -J multiqc -N 1 -n 10 -o multiqc_%j.out -e multiqc_%j.err'}
  }

  withName: RSEQC_INFER_STRAND {
    //container = '/path/rseqc_5.0.4--pyhdfd78af_0.sif'
    clusterOptions = {'-t 10:00:00 -J rseqc -N 1 -n 20 -o rseqc_%j.out -e rseqc_%j.err'}
  }

  withLabel: MAPPING {
    //container = '/path/star-2.7.11b--h5ca1c30_5.sif'
    clusterOptions = {'-t 20:00:00 -J mapping -N 1 -n 20 -o mapping_%j.out -e mapping_%j.err'}
  }

  withName: INDEX_BAM {
    //container = '/path/samtools-1.21--h96c455f_1.sif'
    clusterOptions = {'-t 10:00:00 -J index_bam -N 1 -n 10 -o index_bam_%j.out -e index_bam_%j.err'}
  }

  withLabel: BIGWIG {
    //container = '/path/deeptools-3.5.6--pyhdfd78af_0.sif'
    clusterOptions = {'-t 10:00:00 -J bigwig -N 1 -n 10 -o bigwig_%j.out -e bigwig_%j.err'}
  }
  
  withLabel: FEATURE_COUNTS {
    //container = '/path/subread-2.0.8--h577a1d6_0.sif'
    clusterOptions = {'-t 20:00:00 -J counts -N 1 -n 20 -o counts_%j.out -e counts_%j.err'}
  }

  withLabel: DEEPTOOLS {
    //container = '/path/deeptools-3.5.6--pyhdfd78af_0.sif'
    clusterOptions = {'-t 5:00:00 -J deeptools -N 1 -n 10 -o deeptools_%j.out -e deeptools_%j.err'}
  }

  withLabel: BEDTOOLS {
    //container = '/path/bedtools-2.31.1--hf5e1c6e_2.sif'
    clusterOptions = {'-t 5:00:00 -J bedtools -N 1 -n 10 -o bedtools_%j.out -e bedtools_%j.err'}
  }
}

executor {
    name = 'slurm'
    queueSize = params.queue_size //Queue size is defined in the params.json file
}

singularity {
    enabled = true
    autoMounts = true
}
